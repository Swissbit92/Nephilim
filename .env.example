# =============================================================================
# MCP Coordinator Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# Ollama Configuration (Required)
# =============================================================================
# Ollama API endpoint (default: local server)
OLLAMA_BASE=http://127.0.0.1:11434

# LLM model to use (must be available in Ollama)
# Run: ollama list
# Recommended: ollama pull gemma2:9b-instruct-q5_K_M
PERSONA_MODEL=gemma2:9b-instruct-q5_K_M

# Global LLM sampling temperature (0.0 = deterministic, 2.0 = very creative)
# Recommended: 0.9 for AI companions (balanced creativity)
# Note: Personas can override this via model_preferences.temperature in their JSON
PERSONA_TEMPERATURE=0.9

# Model context window size in tokens
# Adjust based on your model (common values: 4096, 8192, 32768)
MODEL_CONTEXT_WINDOW=4096

# =============================================================================
# Server Configuration (Required)
# =============================================================================
# Backend FastAPI server port
COORD_PORT=8000

# Backend URL for frontend API calls
COORD_URL=http://127.0.0.1:8000

# Directory containing persona JSON files
PERSONA_DIR=personas

# =============================================================================
# Brave MCP Web Search (Optional)
# =============================================================================
# Get your API key from: https://brave.com/search/api/
# Leave blank to disable web search functionality
BRAVE_API_KEY='Your_Brave_API_Key_Here'

# Maximum number of search results to return (1-20)
BRAVE_MAX_RESULTS=5

# Safe search filter: off, moderate, strict
BRAVE_SAFESEARCH=moderate

# Search request timeout in seconds
BRAVE_SEARCH_TIMEOUT=10

# MCP transport protocol (currently only stdio supported)
BRAVE_MCP_TRANSPORT=stdio

# --- Web toolset backend (ADR-009 W1) -------------------------------------
# Backend selection: auto (SearXNG if SEARXNG_BASE_URL set, else Brave) | searxng | brave
WEB_SEARCH_BACKEND=auto
# Self-hosted SearXNG JSON API base URL (empty = Brave-only, legacy behavior).
# Enable: docker run -d -p 8888:8080 searxng/searxng  (settings.yml: search.formats [html, json])
SEARXNG_BASE_URL=
SEARXNG_TIMEOUT=10
# Global safesearch default: off | moderate | strict. Default 'off' for an
# uncensored companion; a persona with nsfw:false is clamped UP to 'moderate'.
WEB_SAFESEARCH_DEFAULT=off

# =============================================================================
# Authentication — Google OAuth + JWT (Required for production)
# =============================================================================
# Set true to require Google login; false for local/dev bypass
AUTH_REQUIRED=false

# Environment: development (HTTP cookies) or production (HTTPS secure cookies)
AUTH_ENV=development

# Google OAuth Client ID — from Google Cloud Console → Credentials
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret — must be at least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-char-string-in-production

# Access token lifetime in hours (default: 1)
JWT_EXPIRE_HOURS=1

# Refresh token lifetime in days (default: 30)
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================================================
# GitHub MCP Plugin (Optional)
# =============================================================================
# Personal Access Token for plugin:github:github MCP server
# Required scopes: repo, read:org, read:user
# Generate at: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# MongoDB MCP removed 2026-06-22

# =============================================================================
# Jupiter Wallet MCP — Solana Trading (Optional - Phase 8)
# =============================================================================
# Enable wallet features (creates wallet SQLite tables, registers /wallet routes)
JUPITER_ENABLED=false

# Docker image for Jupiter MCP server (built from araa47/jupiter-mcp)
JUPITER_MCP_IMAGE=localhost/jupiter-mcp:latest

# Solana RPC endpoint — use devnet for testing, mainnet-beta for live trading
SOLANA_RPC_URL=https://api.devnet.solana.com

# Slippage tolerance in basis points (50 bps = 0.5%)
JUPITER_SLIPPAGE_BPS=50

# Jupiter MCP operation timeout in seconds
JUPITER_TIMEOUT=30

# Directory for autonomous strategy JSON files (like personas/)
STRATEGIES_DIR=strategies

# =============================================================================
# Email Trade Notifications (Optional - Phase 8)
# =============================================================================
# Set true and fill credentials to receive email alerts on trade execution
EMAIL_ENABLED=false

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# =============================================================================
# Memory & RAG Configuration (Optional - Phase 3)
# =============================================================================
# Ollama embedding model for semantic search
# Run: ollama pull nomic-embed-text
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest

# Number of messages before triggering auto-summarization
MEMORY_SUMMARIZATION_INTERVAL=30

# Number of messages before triggering fact extraction for user profiles
MEMORY_FACT_EXTRACTION_INTERVAL=10

# =============================================================================
# LLM Temperature Overrides (Optional)
# =============================================================================
# Operation-specific temperature overrides (0.0-1.0)
# Lower values = more deterministic, higher values = more creative

# First-person voice rewrites
OLLAMA_TEMP_REWRITE=0.2

# Conversation summarization
OLLAMA_TEMP_SUMMARIZATION=0.3

# Fact extraction for user profiles
OLLAMA_TEMP_FACT_EXTRACTION=0.3

# =============================================================================
# Frontend Configuration (Optional)
# =============================================================================
# React dev server port (default: 3000)
REACT_PORT=3000

# =============================================================================
# UI Branding (Optional)
# =============================================================================
# Path to custom app logo (relative to react-ui/public/)
APP_LOGO_PATH=

# Path to custom user avatar (relative to react-ui/public/)
USER_AVATAR=

# =============================================================================
# Database Configuration (Optional)
# =============================================================================
# Path to SQLite database file (default: data/chats.db)
COORDINATOR_DB_PATH=data/chats.db

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# All default to the values below (defaults live in config.py; env just overrides).
#
# NOTE (2026-07-04): PERSONA_LEAN_PROMPT, ROUTING_SEMANTIC_PRIMARY, and
# LORE_ONDEMAND_ENABLED were RETIRED — those behaviors are now unconditional.
# NOTE (2026-07-19): AGENTIC_ENABLED, AGENTIC_TRIGGER_SIMILARITY_THRESHOLD, and
# AGENTIC_EXTRACTION_* were RETIRED with the ADR-004 two-stage pipeline
# (superseded by the ADR-008 tool brain). AGENTIC_ARGUMENT_ALLOWLIST and
# AGENTIC_INJECTION_GUARD remain — they gate live middleware.
# Any lingering values in a local .env are ignored (config uses extra="ignore").

# NEPHILIM seeker-rank prompt block (default on)
LORE_RANK_CONTEXT_ENABLED=true

# Web-search grounding guards (all default off; see docs/decisions & CLAUDE.md)
SEARCH_QUERY_RESOLUTION_ENABLED=false
SEARCH_RELEVANCE_GATE_ENABLED=false
SEARCH_SYNTHESIS_TRUST_RESULTS=false

# Session-context injection — ADR-006 M0.1. PARKED: failed its voice-acceptance
# gate twice; do NOT enable without per-persona framing of the injected content.
MEMORY_CONTEXT_INJECT=false

# Secondary model for A/B comparisons (optional; blank = disabled)
PERSONA_MODEL_B=

# UI toggles (frontend)
UI_CLEAR_ON_SWITCH=false
UI_ENABLE_BALLOONS=true
UI_ENABLE_CARD_GLOW=true

# =============================================================================
# Generated media (Telegram image transport)
# docs/development/TELEGRAM_IMAGE_DELIVERY_PLAN.md
# =============================================================================
# Both flags default OFF. Nothing writes to disk and no endpoint exists until
# they are flipped deliberately.
MEDIA_ENABLED=false
# Base directory for per-session media. Use an ABSOLUTE path in any deployment
# where the Telegram gateway must read these files: it is a separate process
# with a different working directory, so a relative path resolves differently
# in each. The gateway's own TG_MEDIA_ROOT must point at the same place.
MEDIA_ROOT=data/media
# Largest single image accepted, in bytes. Telegram's sendDocument cap is 50 MB.
MEDIA_MAX_BYTES=20000000
# Dev only: exposes POST /sessions/{id}/media/fixture, which stores a generated
# probe PNG and returns a chat-shaped response, proving the transport without a
# generation backend. 404s when OFF.
MEDIA_FIXTURE_ENABLED=false

# =============================================================================
# Example Configurations
# =============================================================================

# --- Minimal Configuration (No Web Search) ---
# OLLAMA_BASE=http://127.0.0.1:11434
# PERSONA_MODEL=gemma2:9b-instruct-q5_K_M
# PERSONA_TEMPERATURE=0.9
# MODEL_CONTEXT_WINDOW=4096
# COORD_PORT=8000
# COORD_URL=http://127.0.0.1:8000
# PERSONA_DIR=personas

# --- Full Configuration (With Web Search) ---
# OLLAMA_BASE=http://127.0.0.1:11434
# PERSONA_MODEL=gemma2:9b-instruct-q5_K_M
# PERSONA_TEMPERATURE=0.9
# MODEL_CONTEXT_WINDOW=4096
# COORD_PORT=8000
# COORD_URL=http://127.0.0.1:8000
# PERSONA_DIR=personas
# BRAVE_API_KEY=BSApJ3xxxxxxxxxxxxxxxxx
# BRAVE_MAX_RESULTS=5
# BRAVE_SAFESEARCH=moderate
# BRAVE_SEARCH_TIMEOUT=10

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Install Ollama: https://ollama.com/download
# 3. Start Ollama: ollama serve
# 4. Pull a model: ollama pull llama3.1:latest
# 5. (Optional) Get Brave API key: https://brave.com/search/api/
# 6. Update .env with your values
# 7. Run setup: ./scripts/setup/setup.sh (macOS/Linux)
# 8. Start app: python scripts/utils/run_react.py
